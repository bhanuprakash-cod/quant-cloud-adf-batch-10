{
	"name": "PL_FILTERACTIVITY",
	"properties": {
		"activities": [
			{
				"name": "Filter Variables",
				"type": "Filter",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('Departments')",
						"type": "Expression"
					},
					"condition": {
						"value": "@contains(item(), 'HR')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Filter Parameters",
				"type": "Filter",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.Numbers",
						"type": "Expression"
					},
					"condition": {
						"value": "@greater(item(),2)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"Numbers": {
				"type": "array",
				"defaultValue": [
					1,
					2,
					3,
					4,
					5,
					6
				]
			}
		},
		"variables": {
			"Departments": {
				"type": "Array",
				"defaultValue": [
					"IT",
					"HR",
					"SALES",
					"CONSULTING"
				]
			}
		},
		"annotations": []
	}
}