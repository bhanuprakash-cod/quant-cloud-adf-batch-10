				"linkedServiceName": {
					"referenceName": "LS_ADLS_GEN2",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": "TestOutput",
						"fileSystem": "adfbatch10"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
