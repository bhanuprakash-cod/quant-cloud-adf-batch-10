{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-adebatch10-dev"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"FileSystem_Ls_Op_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileSystem_Ls_Op'"
		},
		"LS_ADLS_GEN2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_GEN2'"
		},
		"LS_AzureBlob2_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlob2'"
		},
		"LS_AzureBlob_Op_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlob_Op'"
		},
		"LS_ONPREM_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ONPREM'"
		},
		"SqlServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlServer1'"
		},
		"FileSystem_Ls_Op_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "\\\\localhost\\ADFShare"
		},
		"FileSystem_Ls_Op_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "BHANU\\Bhanu"
		},
		"LS_ADLS_GEN2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saadlsbatch10.dfs.core.windows.net/"
		},
		"LS_ONPREM_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "Bhanu"
		},
		"LS_ONPREM_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "bhanu\\bhanu"
		},
		"SqlServer1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "BHANU"
		},
		"SqlServer1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "QUANTCLOUD"
		},
		"SqlServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_user"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-adebatch10-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"LS_ADLS_GEN2_accountKey": {
						"value": "[parameters('LS_ADLS_GEN2_accountKey')]"
					},
					"LS_AzureBlob2_connectionString": {
						"value": "[parameters('LS_AzureBlob2_connectionString')]"
					},
					"LS_AzureBlob_Op_connectionString": {
						"value": "[parameters('LS_AzureBlob_Op_connectionString')]"
					},
					"LS_ADLS_GEN2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_GEN2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-adebatch10-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"FileSystem_Ls_Op_password": {
						"value": "[parameters('FileSystem_Ls_Op_password')]"
					},
					"LS_ONPREM_password": {
						"value": "[parameters('LS_ONPREM_password')]"
					},
					"SqlServer1_password": {
						"value": "[parameters('SqlServer1_password')]"
					},
					"FileSystem_Ls_Op_properties_typeProperties_host": {
						"value": "[parameters('FileSystem_Ls_Op_properties_typeProperties_host')]"
					},
					"FileSystem_Ls_Op_properties_typeProperties_userId": {
						"value": "[parameters('FileSystem_Ls_Op_properties_typeProperties_userId')]"
					},
					"LS_ONPREM_properties_typeProperties_host": {
						"value": "[parameters('LS_ONPREM_properties_typeProperties_host')]"
					},
					"LS_ONPREM_properties_typeProperties_userId": {
						"value": "[parameters('LS_ONPREM_properties_typeProperties_userId')]"
					},
					"SqlServer1_properties_typeProperties_server": {
						"value": "[parameters('SqlServer1_properties_typeProperties_server')]"
					},
					"SqlServer1_properties_typeProperties_database": {
						"value": "[parameters('SqlServer1_properties_typeProperties_database')]"
					},
					"SqlServer1_properties_typeProperties_userName": {
						"value": "[parameters('SqlServer1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-adebatch10-dev_ArmTemplate_0')]"
			]
		}
	]
}